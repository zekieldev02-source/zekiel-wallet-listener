# Application
APP_ENV=development
LOG_LEVEL=INFO

# Backend FastAPI — source de vérité
BACKEND_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=changeme-internal-key

# Helius — WebSocket Enhanced Transactions
# Endpoint atlas pour transactionSubscribe (Geyser-backed)
HELIUS_WS_URL=wss://atlas-mainnet.helius-rpc.com
HELIUS_API_KEY=your-helius-api-key

# Worker
LISTENER_HTTP_PORT=8001
ACTIVE_USERS_REFRESH_SECONDS=60
WS_RECONNECT_SECONDS=5
HTTP_TIMEOUT_SECONDS=5
